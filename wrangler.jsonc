{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earnhub",
  "main": "worker.ts",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "STATIC_ASSETS",
    "not_found_handling": "single-page-application"
  }
}
